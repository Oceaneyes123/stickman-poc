{
  "name": "money-trap",
  "version": "1.0.0",
  "description": "The Money Trap: reusable articulated SVG finance storytelling",
  "type": "module",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "storyboard:design": "node --experimental-strip-types scripts/render/render-cinematic-storyboard.ts",
    "storyboard:all": "node --experimental-strip-types scripts/render/assemble-full-storyboard.ts",
    "cinematic:render": "node --experimental-strip-types scripts/render/render-cinematic-references.ts",
    "storyboard:stills": "node --experimental-strip-types scripts/render/render-storyboard.ts",
    "narrate": "node --experimental-strip-types scripts/narration/narrate.ts",
    "narrate:timing": "python scripts/narration/time_narration.py",
    "narrate:review": "node --experimental-strip-types scripts/render/render-timing-review.ts",
    "opening:stills": "node --experimental-strip-types scripts/render/render-opening-stills.ts",
    "walking:stills": "node --experimental-strip-types scripts/render/render-bank.ts --walking --stills",
    "render:walking": "npm run check && node --experimental-strip-types scripts/render/render-bank.ts --walking",
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src scripts && tsc",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:timing": "python -m unittest discover -s tests -p test_narration_timing.py",
    "check": "npm run lint && npm test && npm run test:timing",
    "render": "npm run render:movement",
    "stills": "npm run movement:stills",
    "render:gallery": "node --experimental-strip-types scripts/render/render-bank.ts --gallery",
    "characters:stills": "node --experimental-strip-types scripts/render/preview-characters.ts",
    "bank:stills": "node --experimental-strip-types scripts/render/render-bank.ts --stills",
    "render:bank": "npm run check && node --experimental-strip-types scripts/render/render-bank.ts",
    "movement:stills": "node --experimental-strip-types scripts/render/render-bank.ts --movement --stills",
    "render:movement": "npm run check && node --experimental-strip-types scripts/render/render-bank.ts --movement",
    "opening:render": "node --experimental-strip-types scripts/render/render-opening-film.ts"
  },
  "allowScripts": {
    "esbuild": false
  }
}
